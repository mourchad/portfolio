{% extends 'admin/base_admin.html.twig' %}

{% block page_title %}Profil & coordonnées{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <div class="panel-card reveal">
            <div class="panel-head">
                <h2><i class="bi bi-person-badge me-2"></i>Présentation, photo, CV et coordonnées</h2>
            </div>

            {{ form_start(form) }}
                {{ form_errors(form) }}

                <h5 class="mt-3 mb-2 text-uppercase small text-dim">Hero (haut de page)</h5>
                <div class="row g-3">
                    <div class="col-12">{{ form_row(form.aboutBadge) }}</div>
                    <div class="col-md-6">{{ form_row(form.typedRolesRaw) }}</div>
                    <div class="col-md-6">{{ form_row(form.heroLead) }}</div>
                    <div class="col-md-4">{{ form_row(form.photoPath) }}</div>
                    <div class="col-md-4">{{ form_row(form.cvPath) }}</div>
                    <div class="col-md-4">{{ form_row(form.statMention) }}</div>
                </div>

                <h5 class="mt-4 mb-2 text-uppercase small text-dim">Coordonnées publiées sur le site</h5>
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.email) }}</div>
                    <div class="col-md-6"></div>
                    <div class="col-md-6">{{ form_row(form.phone1) }}</div>
                    <div class="col-md-6">{{ form_row(form.phone2) }}</div>
                    <div class="col-12">{{ form_row(form.address) }}</div>
                </div>

                <h5 class="mt-4 mb-2 text-uppercase small text-dim">Référencement & pied de page</h5>
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.footerBio) }}</div>
                    <div class="col-md-6">{{ form_row(form.metaDescription) }}</div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top border-secondary-subtle">
                    <button type="submit" class="btn-glow">
                        <i class="bi bi-save me-2"></i>Enregistrer
                    </button>
                </div>
            {{ form_end(form) }}
        </div>

        <p class="small text-dim mt-3">
            <i class="bi bi-shield-check me-1"></i>
            L'email ci-dessus est aussi l'adresse qui reçoit les messages du formulaire de contact.
        </p>
    </div>
</div>
{% endblock %}
