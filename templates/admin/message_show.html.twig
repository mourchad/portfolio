{% extends 'admin/base_admin.html.twig' %}

{% block page_title %}Message de {{ message.name }}{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel-card reveal">
            <div class="message-header d-flex flex-wrap justify-content-between align-items-start gap-3 pb-4 mb-4">
                <div>
                    <h2 class="mb-1">{{ message.subject ?: 'Sans sujet' }}</h2>
                    {% if not message.isRead %}<span class="pill pill-violet">Nouveau</span>{% endif %}
                </div>
                <time class="text-dim small"><i class="bi bi-clock me-1"></i>{{ message.createdAt|format_datetime('full', 'short', locale='fr') }}</time>
            </div>

            <div class="message-sender glass-card mb-4">
                <span class="avatar lg"><i class="bi bi-person-fill"></i></span>
                <div>
                    <strong>{{ message.name }}</strong>
                    <a href="mailto:{{ message.email }}" class="mail-link d-block">{{ message.email }}</a>
                </div>
            </div>

            <div class="message-body">
                {{ message.content|nl2br }}
            </div>

            <div class="d-flex flex-wrap gap-2 mt-5 pt-4 border-top border-secondary-subtle">
                <a href="mailto:{{ message.email }}?subject=RE: {{ message.subject ?: 'Votre message' }}" class="btn-glow">
                    <i class="bi bi-reply me-2"></i>Répondre
                </a>
                <form method="post" action="{{ path('admin_message_delete', {id: message.id}) }}"
                      onsubmit="return confirm('Supprimer définitivement ce message ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_message_' ~ message.id) }}">
                    <button type="submit" class="btn-ghost danger justify-content-center">
                        <i class="bi bi-trash3 me-2"></i>Supprimer
                    </button>
                </form>
                <a href="{{ path('admin_message_index') }}" class="btn-ghost justify-content-center ms-auto">Retour à la liste</a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel-card reveal" style="--d:.08s">
            <div class="panel-head"><h2><i class="bi bi-info-circle me-2"></i>Informations</h2></div>
            <ul class="info-list">
                <li><span>Expéditeur</span><strong>{{ message.name }}</strong></li>
                <li><span>Email</span><strong class="text-break">{{ message.email }}</strong></li>
                <li><span>Sujet</span><strong>{{ message.subject ?: '—' }}</strong></li>
                <li><span>Reçu le</span><strong>{{ message.createdAt|format_datetime('short', 'short', locale='fr') }}</strong></li>
                <li><span>Statut</span><strong>{{ message.isRead ? 'Lu' : 'Non lu' }}</strong></li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}
