{% extends 'admin/base_admin.html.twig' %}

{% block page_title %}{% if isEdit %}Modifier : {{ link.label }}{% else %}Nouveau lien social{% endif %}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="panel-card reveal">
            <div class="panel-head">
                <h2>
                    <i class="bi {{ isEdit ? 'bi-pencil-square' : 'bi-plus-circle' }} me-2"></i>
                    {% if isEdit %}Modifier le lien social{% else %}Ajouter un réseau social{% endif %}
                </h2>
            </div>

            {{ form_start(form) }}
                {{ form_errors(form) }}

                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.label) }}</div>
                    <div class="col-md-3">{{ form_row(form.icon) }}</div>
                    <div class="col-md-3">{{ form_row(form.position) }}</div>
                    <div class="col-12">{{ form_row(form.url) }}</div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top border-secondary-subtle">
                    <button type="submit" class="btn-glow">
                        <i class="bi bi-save me-2"></i>{{ isEdit ? 'Enregistrer les modifications' : 'Créer le lien' }}
                    </button>
                    <a href="{{ path('admin_social_index') }}" class="btn-ghost justify-content-center">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
