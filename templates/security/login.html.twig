{% extends 'base.html.twig' %}

{% block title %}Connexion — Espace Administrateur | M - Creative &amp; Digital{% endblock %}

{% block body %}
<section class="login-page">
    <div class="orb orb-violet"></div>
    <div class="orb orb-blue"></div>
    <div class="grid-overlay"></div>

    <div class="container position-relative">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-md-7 col-lg-5">
                <div class="glass-card login-card reveal-zoom">
                    <div class="text-center mb-4">
                        <span class="brand-badge lg"><img src="{{ asset('assets/img/logo.jpeg') }}" alt="" class="brand-img"></span>
                        <h1 class="login-title mt-3">Espace Administrateur</h1>
                        <p class="text-dim small mb-0">Accès réservé — authentification requise</p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger d-flex align-items-center gap-2">
                            <i class="bi bi-shield-exclamation"></i>
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="post" autocomplete="off">
                        <div class="mb-3">
                            <label for="inputEmail" class="form-label">Adresse email</label>
                            <div class="input-icon-wrap">
                                <i class="bi bi-envelope"></i>
                                <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
                                       class="form-control" placeholder="admin@mourchad.com"
                                       autocomplete="username" required autofocus>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label for="inputPassword" class="form-label">Mot de passe</label>
                            <div class="input-icon-wrap">
                                <i class="bi bi-key"></i>
                                <input type="password" name="password" id="inputPassword"
                                       class="form-control" placeholder="••••••••••"
                                       autocomplete="current-password" required>
                            </div>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn-glow w-100">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                        </button>
                    </form>

                    <a href="{{ path('app_home') }}" class="back-link mt-4 d-block text-center">
                        <i class="bi bi-arrow-left me-1"></i>Retour au portfolio
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
